# Copy to backend/.env and fill in. Never commit .env.

# Neon: Dashboard → Connect → copy the *pooled* connection string (host has "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Migrations run best over the direct (non-pooled) host. Optional; falls back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Where this API is reachable from the phone. Google redirects back to PUBLIC_URL/auth/google/callback.
PUBLIC_URL=http://localhost:8000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → type "Web application".
# Authorised redirect URI: PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
