<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <LinearLayout style="@style/Card" android:layout_marginBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/tv_div" style="@style/Badge" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView android:id="@+id/tv_countdown" style="@style/Badge" />
        </LinearLayout>

        <TextView android:id="@+id/tv_name" style="@style/Name" android:layout_marginTop="12dp" android:fontFamily="@font/hg_extrabold" android:letterSpacing="-0.01" android:textSize="19sp" />

        <TextView android:id="@+id/tv_time" style="@style/Label" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:textSize="13sp" />

        <TextView android:id="@+id/btn_remind" style="@style/ChipGhost" />
    </LinearLayout>
</LinearLayout>
