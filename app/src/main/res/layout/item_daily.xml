<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/tv_slot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/hg_semibold" android:textColor="@color/text" android:textSize="13sp" />

        <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:fontFamily="@font/hg_semibold" android:textColor="@color/text" android:textSize="13sp" />

        <TextView android:id="@+id/tv_rating" style="@style/Badge" android:background="@drawable/bg_chip_soft" android:paddingStart="11dp" android:paddingEnd="11dp" android:textColor="@color/text" android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/hg_extrabold"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="1.05"
        android:textColor="@color/text"
        android:textSize="23sp" />

    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:alpha="0.72"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_open" style="@style/Chip" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="Solve" />
        <TextView android:id="@+id/btn_bookmark" style="@style/ChipSoft" android:text="Save" />
        <TextView android:id="@+id/btn_swap" style="@style/ChipSoft" android:text="Swap" />
        <TextView android:id="@+id/btn_code" style="@style/ChipSoft" android:layout_marginEnd="0dp" android:fontFamily="monospace" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="&lt;/&gt;" />
    </LinearLayout>
</LinearLayout>
