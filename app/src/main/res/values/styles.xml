<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">@font/host_grotesk</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/subtext</item>
        <item name="android:textColorHint">@color/faint</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/hg_extrabold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Primary action: solid ink pill. -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/hg_semibold</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>

    <style name="ChipGhost" parent="Chip">
        <item name="android:background">@drawable/bg_chip_ghost</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Quiet action sitting on a coloured card. -->
    <style name="ChipSoft" parent="Chip">
        <item name="android:background">@drawable/bg_chip_soft</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Action on the dark hero. -->
    <style name="ChipLight" parent="Chip">
        <item name="android:background">@drawable/bg_chip_light</item>
        <item name="android:textColor">#15141A</item>
    </style>

    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/hg_extrabold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="Name">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/hg_semibold</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/subtext</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Quiet caption. -->
    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/faint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/hg_semibold</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="TileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/hg_extrabold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">textNoSuggestions</item>
    </style>

    <style name="HeroLabel" parent="Label">
        <item name="android:textColor">@color/hero_sub</item>
    </style>

    <style name="HeroValue" parent="TileValue">
        <item name="android:textColor">@color/hero_text</item>
    </style>

    <style name="TabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="TabLabel" parent="Label">
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
